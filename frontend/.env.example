# Where the Next.js server reaches the FastAPI backend (server-side only; the
# browser never talks to the backend directly, it goes through /api/v1 on this app).
BACKEND_URL=http://127.0.0.1:8000

# Where the browser opens the realtime WebSocket (the API's address as seen from the
# user's machine). The API must list this app's origin in CORS_ALLOWED_ORIGINS.
PUBLIC_WS_URL=ws://127.0.0.1:8000
