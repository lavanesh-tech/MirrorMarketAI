# MirrorMarket AI - example environment.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials. Values below are local
# development defaults only; they are not secret and must not be used anywhere else.

# --- Application -------------------------------------------------------------
# local | test | staging | production
APP_ENV=local
DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json | console  (production requires json)
LOG_FORMAT=console
# Comma-separated list of browser origins allowed to call the API (frontend, Phase 24).
# Leave empty to disable CORS entirely. "*" is rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Docker Compose: local infrastructure ------------------------------------
POSTGRES_USER=mirrormarket
POSTGRES_PASSWORD=mirrormarket
POSTGRES_DB=mirrormarket
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8000

# --- PostgreSQL + pgvector --------------------------------------------------
# For running the API / Alembic on your Mac against the Compose database.
# (Inside Compose, the api and migrate services override this to use host "postgres".)
# Must use the postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://mirrormarket:mirrormarket@localhost:5433/mirrormarket
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false
READINESS_TIMEOUT_SECONDS=2

# --- Authentication ----------------------------------------------------------
# Local/test may use the built-in dev secret. staging/production REQUIRE a unique
# secret of 32+ characters, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_TTL_MINUTES=15

# --- Source ingestion ------------------------------------------------------
INGESTION_MAX_BYTES=5242880
INGESTION_TIMEOUT_SECONDS=10
INGESTION_MAX_REDIRECTS=5
# Comma-separated ports user URLs may use (everything else is blocked).
INGESTION_ALLOWED_PORTS=80,443
INGESTION_MAX_PDF_PAGES=200

# --- Redis: cache, rate limits, idempotency (empty REDIS_URL disables them) ---
REDIS_URL=redis://localhost:6380/0
REDIS_TIMEOUT_SECONDS=0.5
REDIS_KEY_PREFIX=mm:
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AGENTS_PER_MINUTE=30
PRICE_CACHE_TTL_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_LOCK_SECONDS=300
IDEMPOTENCY_MAX_BODY_BYTES=1048576

# --- Realtime (WebSockets; see docs/REALTIME.md) -----------------------------
WS_AUTH_TIMEOUT_SECONDS=5
WS_HEARTBEAT_SECONDS=20
WS_IDLE_TIMEOUT_SECONDS=60
WS_MAX_CONNECTIONS_PER_USER=5
WS_SEND_QUEUE_SIZE=100
WS_MAX_MESSAGE_BYTES=4096
WS_MAX_MESSAGES_PER_10S=30
PRESENCE_TTL_SECONDS=45

# --- OpenAI (used from Phase 6; leave empty until then) ---------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Chunking + embeddings ---------------------------------------------------
# hashing = deterministic offline embeddings (no key needed; lexical only).
# openai  = real semantic embeddings (requires OPENAI_API_KEY).
EMBEDDING_PROVIDER=hashing
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3
EMBEDDING_JOB_MAX_ATTEMPTS=3
CHUNK_TARGET_CHARS=2000
CHUNK_OVERLAP_CHARS=200
WORKER_POLL_INTERVAL_SECONDS=2

# --- Requirements extraction ---------------------------------------------------
# rules  = deterministic offline extractor (no key needed).
# openai = structured outputs with OPENAI_CHAT_MODEL (requires OPENAI_API_KEY).
REQUIREMENTS_EXTRACTOR=rules
REQUIREMENTS_MAX_TEXT_CHARS=4000

# --- Agents ----------------------------------------------------------------------
# rules  = deterministic offline agents (no key needed).
# openai = OPENAI_CHAT_MODEL reads evidence packs; citations are validated.
AGENT_ENGINE=rules
AGENT_EVIDENCE_PER_CRITERION=3
AGENT_MAX_REVIEW_CHUNKS=60
ORCHESTRATION_TIME_BUDGET_SECONDS=120
ORCHESTRATION_MAX_PRODUCTS=10
ORCHESTRATION_TOKEN_BUDGET=50000
PRICE_MAX_AGE_DAYS=30

# --- Events: outbox + Kafka (see docs/EVENTS.md) ----------------------------
# Compose sets KAFKA_ENABLED=true and KAFKA_BOOTSTRAP_SERVERS=kafka:9092 for containers.
# From the host, the Compose broker is at localhost:9094.
KAFKA_HOST_PORT=9094
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_CLIENT_ID=mirrormarket-api
KAFKA_TOPIC_PARTITIONS=3
KAFKA_CONSUMER_MAX_ATTEMPTS=3
KAFKA_CONSUMER_BACKOFF_SECONDS=0.5
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_HOURS=72
OUTBOX_POLL_INTERVAL_SECONDS=1
