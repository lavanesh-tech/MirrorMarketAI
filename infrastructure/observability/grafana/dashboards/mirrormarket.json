      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mm_http_requests_total{status=~\"5..\"}[$__rate_interval])) / sum(rate(mm_http_requests_total[$__rate_interval]))",
          "instant": false,
          "range": true
